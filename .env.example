# ARC-AGI-3 API Configuration (REQUIRED)
# Get your API key from the ARC-AGI-3 platform
ARC_API_KEY=

# Optional: Database Configuration.
# LEAVE UNSET unless you mean it. The default is anchored under .runs/ -- a worker in
# its own box gets <box>/core_data.db, anything else gets .runs/core_data.db. A path
# here that lands outside .runs/ is REFUSED at startup, loudly, by name (D-7).
# A relative value contributes its FILENAME only; it is never joined to the cwd.
# DATABASE_PATH=

# Optional: Logging Configuration
LOG_LEVEL=INFO

# Optional: API Configuration
ARC_BASE_URL=https://three.arcprize.org

# Python Configuration
# Disable Python bytecode (.pyc) file generation
PYTHONDONTWRITEBYTECODE=1
